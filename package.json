{
  "name": "javui-workspace",
  "private": true,
  "workspaces": ["packages/*", "apps/*"],
  "scripts": {
    "dev": "bun run --filter @javui/docs dev",
    "build": "bun run --filter @javui/docs build",
    "typecheck": "bun run --filter @javui/ui typecheck && bun run --filter @javui/docs typecheck",
    "start": "bun run --filter @javui/docs start",
    "lint": "eslint apps/docs/src packages/ui/src",
    "storybook": "bun run --filter @javui/ui storybook",
    "build-storybook": "bun run --filter @javui/ui build-storybook",
    "tokens": "bun run --filter @javui/ui tokens",
    "icons": "bun run --filter @javui/ui icons",
    "test": "bun run --filter @javui/ui test",
    "agent-docs": "bun run --filter @javui/ui agent-docs",
    "mcp": "bun run --filter @javui/ui mcp",
    "mcp:test": "bun run --filter @javui/ui mcp:test"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource/commit-mono": "^5.3.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "shiki": "^4.5.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "latest",
    "@phosphor-icons/core": "^2.1.1",
    "@storybook/addon-a11y": "^10.6.1",
    "@storybook/addon-docs": "^10.6.1",
    "@storybook/addon-mcp": "^10.6.1",
    "@storybook/addon-vitest": "^10.6.1",
    "@storybook/nextjs-vite": "^10.6.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/culori": "^4.0.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/browser-playwright": "5.0.3",
    "@vitest/coverage-v8": "5.0.3",
    "culori": "^4.0.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "jsdom": "^30.1.2",
    "madge": "^8.0.0",
    "playwright": "latest",
    "react-docgen-typescript": "^2.4.0",
    "storybook": "^10.6.1",
    "style-dictionary": "^5.6.1",
    "tsup": "^9.0.0",
    "typescript": "^5",
    "vite": "latest",
    "vitest": "^5.0.3",
    "vitest-axe": "^0.1.0"
  },
  "packageManager": "bun@1.4.2",
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
