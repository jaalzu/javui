{
  "color": {
    "$description": "Semantic color tokens, light theme. Same keys as the dark theme. Components use only these.",
    "page": {
      "$value": "color-mix(in oklab, {primitive.color.white} 70%, {primitive.color.neutral.50})",
      "$type": "color",
      "$description": "The page itself. Everything sits on it."
    },
    "card": {
      "$value": "{primitive.color.white}",
      "$type": "color",
      "$description": "Content blocks on the page: cards, panels, table rows."
    },
    "sunken": {
      "$value": "color-mix(in oklab, {color.primary-foreground} 4%, {color.page})",
      "$type": "color",
      "$description": "Recessed areas: code blocks, wells, inset fields."
    },
    "highlight": {
      "$value": "color-mix(in oklab, {color.primary-foreground} 3%, {color.card})",
      "$type": "color",
      "$description": "Highlighted panel inside a card: a metric, total or goal that should stand out. Lighter than the card in dark, soft gray in light. Never nest a highlight inside another highlight."
    },
    "modal": {
      "$value": "{primitive.color.white}",
      "$type": "color",
      "$description": "Layers above the page: dialog, menu, select list, popover."
    },
    "component": {
      "$value": "oklch(0 0 0 / 0.05)",
      "$type": "color",
      "$description": "Background of interactive controls at rest: inputs, secondary buttons, toggles."
    },
    "component-hover": {
      "$value": "color-mix(in oklab, {color.primary-foreground} 8%, transparent)",
      "$type": "color",
      "$description": "Component hovered."
    },
    "component-active": {
      "$value": "color-mix(in oklab, {color.primary-foreground} 12%, transparent)",
      "$type": "color",
      "$description": "Component pressed."
    },
    "component-on-sunken": {
      "$value": "{color.card}",
      "$type": "color",
      "$description": "Component placed on a sunken area, so it still stands out."
    },
    "transparent-hover": {
      "$value": "color-mix(in oklab, {color.primary-foreground} 6%, transparent)",
      "$type": "color",
      "$description": "Ghost control or list item hovered."
    },
    "transparent-active": {
      "$value": "color-mix(in oklab, {color.primary-foreground} 10%, transparent)",
      "$type": "color",
      "$description": "Ghost control pressed, or list item selected or highlighted."
    },
    "primary-foreground": {
      "$value": "{primitive.color.neutral.950}",
      "$type": "color",
      "$description": "Main text and icons."
    },
    "secondary-foreground": {
      "$value": "color-mix(in oklch, {color.primary-foreground} 70%, transparent)",
      "$type": "color",
      "$description": "Supporting text."
    },
    "tertiary-foreground": {
      "$value": "color-mix(in oklch, {color.primary-foreground} 62%, transparent)",
      "$type": "color",
      "$description": "Hints, placeholders, metadata."
    },
    "disabled-foreground": {
      "$value": "color-mix(in oklab, {color.primary-foreground} 62%, transparent)",
      "$type": "color",
      "$description": "Text and icons of disabled controls."
    },
    "inverted-solid": {
      "$value": "{primitive.color.neutral.950}",
      "$type": "color",
      "$description": "Primary action background: the main button."
    },
    "inverted-solid-hover": {
      "$value": "color-mix(in oklab, {color.inverted-solid} 82%, {color.page})",
      "$type": "color",
      "$description": "Inverted solid hovered."
    },
    "inverted-solid-active": {
      "$value": "color-mix(in oklab, {color.inverted-solid} 72%, {color.page})",
      "$type": "color",
      "$description": "Inverted solid pressed."
    },
    "on-inverted-foreground": {
      "$value": "{primitive.color.neutral.50}",
      "$type": "color",
      "$description": "Text on inverted solid surfaces."
    },
    "brand-solid": {
      "$value": "{primitive.color.accent.500}",
      "$type": "color",
      "$description": "Brand background for key actions and selected states."
    },
    "brand-solid-hover": {
      "$value": "color-mix(in oklab, {color.brand-solid} 88%, {color.primary-foreground})",
      "$type": "color",
      "$description": "Brand solid hovered."
    },
    "brand-subtle": {
      "$value": "color-mix(in oklab, {color.brand-solid} 12%, transparent)",
      "$type": "color",
      "$description": "Soft brand tint behind text or icons."
    },
    "brand-foreground": {
      "$value": "color-mix(in oklab, {color.brand-solid} 75%, {color.primary-foreground})",
      "$type": "color",
      "$description": "Brand colored text and icons on the page and cards, derived from --color-brand-solid."
    },
    "brand-foreground-soft": {
      "$value": "color-mix(in oklab, {color.brand-solid} 60%, {color.primary-foreground})",
      "$type": "color",
      "$description": "Brand text and icons for tinted surfaces, derived from --color-brand-solid."
    },
    "on-brand-solid-foreground": {
      "$value": "{primitive.color.white}",
      "$type": "color",
      "$description": "Text on brand solid."
    },
    "positive-solid": {
      "$value": "{primitive.color.success.700}",
      "$type": "color",
      "$description": "Positive background for strong feedback."
    },
    "positive-solid-hover": {
      "$value": "color-mix(in oklab, {color.positive-solid} 88%, {color.primary-foreground})",
      "$type": "color",
      "$description": "Positive solid hovered."
    },
    "positive-subtle": {
      "$value": "color-mix(in oklab, {color.positive-solid} 12%, transparent)",
      "$type": "color",
      "$description": "Soft positive tint behind text or icons."
    },
    "positive-foreground": {
      "$value": "{color.positive-solid}",
      "$type": "color",
      "$description": "Positive colored text and icons."
    },
    "on-positive-solid-foreground": {
      "$value": "{primitive.color.white}",
      "$type": "color",
      "$description": "Text on positive solid."
    },
    "warning-solid": {
      "$value": "{primitive.color.warning.700}",
      "$type": "color",
      "$description": "Warning background for strong feedback."
    },
    "warning-solid-hover": {
      "$value": "color-mix(in oklab, {color.warning-solid} 88%, {color.primary-foreground})",
      "$type": "color",
      "$description": "Warning solid hovered."
    },
    "warning-subtle": {
      "$value": "color-mix(in oklab, {color.warning-solid} 12%, transparent)",
      "$type": "color",
      "$description": "Soft warning tint behind text or icons."
    },
    "warning-foreground": {
      "$value": "{color.warning-solid}",
      "$type": "color",
      "$description": "Warning colored text and icons."
    },
    "warning-bright": {
      "$value": "oklch(0.62 0.16 88)",
      "$type": "color",
      "$description": "Brighter, more saturated warning for a tone that must read as yellow, such as an alert icon, title, border and background. The solid step stays darker for text on a solid fill."
    },
    "on-warning-solid-foreground": {
      "$value": "{primitive.color.white}",
      "$type": "color",
      "$description": "Text on warning solid."
    },
    "info-solid": {
      "$value": "{primitive.color.info.700}",
      "$type": "color",
      "$description": "Info background for strong feedback."
    },
    "info-solid-hover": {
      "$value": "color-mix(in oklab, {color.info-solid} 88%, {color.primary-foreground})",
      "$type": "color",
      "$description": "Info solid hovered."
    },
    "info-subtle": {
      "$value": "color-mix(in oklab, {color.info-solid} 12%, transparent)",
      "$type": "color",
      "$description": "Soft info tint behind text or icons."
    },
    "info-foreground": {
      "$value": "{color.info-solid}",
      "$type": "color",
      "$description": "Info colored text and icons."
    },
    "on-info-solid-foreground": {
      "$value": "{primitive.color.white}",
      "$type": "color",
      "$description": "Text on info solid."
    },
    "danger-solid": {
      "$value": "{primitive.color.danger.700}",
      "$type": "color",
      "$description": "Danger background for strong feedback."
    },
    "danger-solid-hover": {
      "$value": "color-mix(in oklab, {color.danger-solid} 88%, {color.primary-foreground})",
      "$type": "color",
      "$description": "Danger solid hovered."
    },
    "danger-solid-active": {
      "$value": "color-mix(in oklab, {color.danger-solid} 78%, {color.primary-foreground})",
      "$type": "color",
      "$description": "Danger solid pressed."
    },
    "danger-subtle": {
      "$value": "color-mix(in oklab, {color.danger-solid} 12%, transparent)",
      "$type": "color",
      "$description": "Soft danger tint behind text or icons."
    },
    "danger-subtle-hover": {
      "$value": "color-mix(in oklab, {color.danger-solid} 20%, transparent)",
      "$type": "color",
      "$description": "Danger subtle hovered, e.g. destructive menu item."
    },
    "danger-foreground": {
      "$value": "{color.danger-solid}",
      "$type": "color",
      "$description": "Danger colored text and icons."
    },
    "on-danger-solid-foreground": {
      "$value": "{primitive.color.white}",
      "$type": "color",
      "$description": "Text on danger solid."
    },
    "border-default": {
      "$value": "color-mix(in oklch, {color.primary-foreground} 7%, transparent)",
      "$type": "color",
      "$description": "Default borders: inputs, cards, dividers you can see."
    },
    "border-strong": {
      "$value": "color-mix(in oklch, {color.primary-foreground} 9%, transparent)",
      "$type": "color",
      "$description": "Emphasized borders and hover."
    },
    "border-disabled": {
      "$value": "color-mix(in oklab, {color.primary-foreground} 10%, transparent)",
      "$type": "color",
      "$description": "Borders of disabled controls."
    },
    "brand-border-default": {
      "$value": "color-mix(in oklab, {color.brand-solid} 40%, transparent)",
      "$type": "color",
      "$description": "Brand border: selected card, active field."
    },
    "brand-border-focus": {
      "$value": "{color.primary-foreground}",
      "$type": "color",
      "$description": "Focus ring."
    },
    "positive-border-default": {
      "$value": "color-mix(in oklab, {color.positive-solid} 40%, transparent)",
      "$type": "color",
      "$description": "Positive border."
    },
    "warning-border-default": {
      "$value": "color-mix(in oklab, {color.warning-solid} 40%, transparent)",
      "$type": "color",
      "$description": "Warning border."
    },
    "info-border-default": {
      "$value": "color-mix(in oklab, {color.info-solid} 40%, transparent)",
      "$type": "color",
      "$description": "Info border."
    },
    "danger-border-default": {
      "$value": "color-mix(in oklab, {color.danger-solid} 40%, transparent)",
      "$type": "color",
      "$description": "Danger border."
    },
    "disabled": {
      "$value": "color-mix(in oklab, {color.primary-foreground} 6%, transparent)",
      "$type": "color",
      "$description": "Background of disabled controls."
    },
    "overlay": {
      "$value": "oklch(0 0 0 / 0.4)",
      "$type": "color",
      "$description": "Backdrop behind dialogs."
    }
  },
  "syntax": {
    "$description": "Syntax highlighting for code. One layer on top of --color-sunken; the CodeBlock tone is separate.",
    "text": {
      "$value": "{color.primary-foreground}",
      "$type": "color",
      "$description": "Default code text: variables, operators, plain identifiers."
    },
    "keyword": {
      "$value": "{color.brand-foreground-soft}",
      "$type": "color",
      "$description": "Language keywords and control flow. Uses the softer brand text so it passes contrast on --color-sunken."
    },
    "string": {
      "$value": "{color.positive-foreground}",
      "$type": "color",
      "$description": "Strings and template literals."
    },
    "number": {
      "$value": "color-mix(in oklab, {color.warning-foreground} 88%, {color.primary-foreground})",
      "$type": "color",
      "$description": "Numbers, units and constants."
    },
    "function": {
      "$value": "color-mix(in oklab, {color.info-foreground} 88%, {color.primary-foreground})",
      "$type": "color",
      "$description": "Function and method names."
    },
    "comment": {
      "$value": "{color.tertiary-foreground}",
      "$type": "color",
      "$description": "Comments, quieter than code."
    },
    "punctuation": {
      "$value": "{color.secondary-foreground}",
      "$type": "color",
      "$description": "Braces, brackets, separators and other punctuation."
    },
    "danger": {
      "$value": "{color.danger-foreground}",
      "$type": "color",
      "$description": "Removed code in a diff."
    },
    "diff-added-bg": {
      "$value": "{color.positive-subtle}",
      "$type": "color",
      "$description": "Background of an added line in a diff."
    },
    "diff-removed-bg": {
      "$value": "{color.danger-subtle}",
      "$type": "color",
      "$description": "Background of a removed line in a diff."
    }
  },
  "shadow": {
    "$description": "Elevation, four levels, plus `inset-ring` for quiet outlines. Each elevation level starts with a 1px ring so the edge reads on any surface. Dark values are the reference; light values are the same shapes with dark alphas, except `raised`, which drops the soft drop.",
    "inset-ring": {
      "$value": "inset 0 0 0 1px #00000014",
      "$type": "shadow",
      "$description": "A quiet 1px ring drawn inside the edge, so it never grows the box or reads as a heavy border. Use it on badges, chips and selected states."
    },
    "default": {
      "$value": "0 0 0 1px #0000000f, 0 1px 2px #0000001a",
      "$type": "shadow",
      "$description": "A small lift for controls at rest that should feel pressable: slider thumbs, raised buttons, tabs."
    },
    "raised": {
      "$value": "inset 0 0 0 1px transparent, inset 0 1px #ffffffcc, 0 0 0 1px #00000014",
      "$type": "shadow",
      "$description": "Raised look for secondary controls in light: inner hairline, top highlight and outer edge, with no soft drop so the control stays flat."
    },
    "large": {
      "$value": "0 0 0 1px #00000014, 0 2px 3px -2px #0000001a, 0 3px 8px -2px #00000014, 0 4px 12px -4px #0000001f",
      "$type": "shadow",
      "$description": "Floating panels anchored to a trigger: menus, select lists, popovers, tooltips and toasts."
    },
    "extra-large": {
      "$value": "0 0 0 .5px #00000014, 0 8px 40px 0px #0000001a, 0 12px 32px -16px #00000040",
      "$type": "shadow",
      "$description": "Surfaces that sit above the whole page: dialogs and the search palette."
    }
  }
}
