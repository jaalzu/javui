      "name": "color.bg",
      "cssVar": "--color-bg",
      "type": "color",
      "group": "semantic-color",
      "description": "Page background.",
      "light": "color-mix(in oklab, var(--primitive-color-neutral-50) 66%, var(--primitive-color-neutral-100))",
      "dark": "color-mix(in oklab, var(--primitive-color-neutral-950) 70%, var(--primitive-color-black))"
    },
    {
      "name": "color.surface",
      "cssVar": "--color-surface",
      "type": "color",
      "group": "semantic-color",
      "description": "Raised areas (cards, inputs) drawn over bg.",
      "light": "oklch(0 0 0 / 0.05)",
      "dark": "oklch(1 0 0 / 0.102)"
    },
    {
      "name": "color.surface-2",
      "cssVar": "--color-surface-2",
      "type": "color",
      "group": "semantic-color",
      "description": "Second surface level for cards and example areas: whiter than bg in light, lighter gray than bg in dark. Opaque, so it can sit on any background.",
      "light": "var(--primitive-color-white)",
      "dark": "color-mix(in oklab, var(--color-fg) 8%, var(--color-bg))"
    },
    {
      "name": "color.surface-raised",
      "cssVar": "--color-surface-raised",
      "type": "color",
      "group": "semantic-color",
      "description": "Opaque surface for floating panels (dialogs, select popups, menus). Mixed in oklab because the near-neutral fg has no meaningful hue in oklch.",
      "light": "color-mix(in oklab, var(--color-fg) 6%, var(--color-bg))",
      "dark": "color-mix(in oklab, var(--color-fg) 6%, var(--color-bg))"
    },
    {
      "name": "color.fg",
      "cssVar": "--color-fg",
      "type": "color",
      "group": "semantic-color",
      "description": "Primary text.",
      "light": "var(--primitive-color-neutral-950)",
      "dark": "var(--primitive-color-neutral-100)"
    },
    {
      "name": "color.fg-muted",
      "cssVar": "--color-fg-muted",
      "type": "color",
      "group": "semantic-color",
      "description": "Secondary text.",
      "light": "color-mix(in oklch, var(--color-fg) 70%, transparent)",
      "dark": "color-mix(in oklch, var(--color-fg) 70%, transparent)"
    },
    {
      "name": "color.fg-subtle",
      "cssVar": "--color-fg-subtle",
      "type": "color",
      "group": "semantic-color",
      "description": "Tertiary, non-essential text. Over the translucent surface it can fall below 4.5:1, so do not use it for placeholders or required information.",
      "light": "color-mix(in oklch, var(--color-fg) 62%, transparent)",
      "dark": "color-mix(in oklch, var(--color-fg) 54%, transparent)"
    },
    {
      "name": "color.border",
      "cssVar": "--color-border",
      "type": "color",
      "group": "semantic-color",
      "description": "Decorative dividers and card edges. Very soft on purpose.",
      "light": "color-mix(in oklch, var(--color-fg) 7%, transparent)",
      "dark": "color-mix(in oklch, var(--color-fg) 7%, transparent)"
    },
    {
      "name": "color.border-strong",
      "cssVar": "--color-border-strong",
      "type": "color",
      "group": "semantic-color",
      "description": "Boundary of interactive controls (inputs, secondary button, kbd). Soft by design: below the 3:1 non-text contrast of WCAG 1.4.11, so the control also keeps its surface fill and the focus ring stays strong.",
      "light": "color-mix(in oklch, var(--color-fg) 18%, transparent)",
      "dark": "color-mix(in oklch, var(--color-fg) 18%, transparent)"
    },
    {
      "name": "color.button",
      "cssVar": "--color-button",
      "type": "color",
      "group": "semantic-color",
