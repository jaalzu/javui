{
  "radius": {
    "$type": "dimension",
    "none": { "$value": "0" },
    "base": {
      "$value": "0.5rem",
      "$description": "Base radius. sm, md, lg and xl derive from it at 0.5x, 1x, 1.5x and 2x."
    },
    "sm": { "$value": "calc(var(--radius-base) * 0.5)" },
    "md": { "$value": "calc(var(--radius-base) * 1)" },
    "lg": { "$value": "calc(var(--radius-base) * 1.5)" },
    "xl": { "$value": "calc(var(--radius-base) * 2)" },
    "full": { "$value": "9999px" }
  },
  "border": {
    "width": {
      "$type": "dimension",
      "thin": { "$value": "1px" },
      "thick": { "$value": "2px" }
    }
  },
  "focus": {
    "ring": {
      "$type": "dimension",
      "$description": "Focus ring: outline: var(--focus-ring-width) solid var(--color-brand-border-focus); outline-offset: var(--focus-ring-offset). Never remove it without a replacement.",
      "width": { "$value": "3px" },
      "offset": { "$value": "2px" }
    }
  },
  "opacity": {
    "disabled": { "$value": "0.5" }
  }
}
