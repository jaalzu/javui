{
  "name": "@javui/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": ["dist", "agent", "README.md", "LICENSE"],
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./server": { "types": "./dist/server.d.ts", "import": "./dist/server.js" },
    "./tokens.css": "./dist/tokens/tokens.css",
    "./global.css": "./dist/styles/global.css",
    "./base.css": "./dist/styles/base.css",
    "./fonts.css": "./dist/styles/fonts.css",
    "./tailwind.css": "./dist/tokens/tailwind.css",
    "./styles.css": "./dist/styles.css",
    "./styles/*": "./dist/styles/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "dev": "bun scripts/dev.mjs",
    "storybook": "bun run tokens && storybook dev -p 6006",
    "build-storybook": "bun run tokens && storybook build",
    "tokens": "bun scripts/build-tokens.mjs",
    "icons": "bun scripts/generate-icons.mjs",
    "agent-docs": "bun scripts/build-agent-docs.mjs",
    "build": "bun scripts/build-dist.mjs",
    "verify:dist": "bun scripts/verify-dist.mjs",
    "mcp": "bun mcp/server.mjs",
    "mcp:test": "bun mcp/smoke-test.mjs"
  }
}
