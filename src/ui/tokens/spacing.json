{
  "space": {
    "$type": "dimension",
    "$description": "Spacing scale on a 4px base. The number is the multiple of 4px (space.4 = 16px).",
    "0": { "$value": "0" },
    "1": { "$value": "0.25rem" },
    "1-5": { "$value": "0.375rem" },
    "2": { "$value": "0.5rem" },
    "2-5": {
      "$value": "0.6rem",
      "$description": "Half step between space.2 and space.3. Used for the inline padding of Badges."
    },
    "3": { "$value": "0.75rem" },
    "4": { "$value": "1rem" },
    "5": { "$value": "1.25rem" },
    "6": { "$value": "1.5rem" },
    "8": { "$value": "2rem" },
    "10": { "$value": "2.5rem" },
    "12": { "$value": "3rem" },
    "16": { "$value": "4rem" },
    "20": { "$value": "5rem" }
  }
}
